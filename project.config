[access]
	inheritFrom = All-Projects
[receive]
	requireChangeId = true
[project]
	description = Application-Layer Traffic Optimization (ALTO)
	state = read only
[access "refs/*"]
	read = block group GitHub Replication
	owner = group saml/odl-gerrit-alto-committers
[allowSuperproject "releng/autorelease"]
	matching = refs/heads/stable/nitrogen:refs/heads/stable/nitrogen
